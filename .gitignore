__pycache__/
*.pyc
.venv/
venv/
.env

# Downloaded/raw source files are build artifacts, not source —
# pipelines regenerate them from the fetch functions.
data/raw/**
!data/raw/**/.gitkeep
data/processed/**
!data/processed/.gitkeep

# data/food_access.db and web/data/*.geojson are tracked on purpose:
# manual edits/deletes made through the map (see README's "Manual
# editing") and the housing/food-store dedup passes live only in this
# database — there's no other copy of that curation, so it's committed
# as real project state rather than treated as a disposable build
# artifact regenerated from scratch by the pipelines.
